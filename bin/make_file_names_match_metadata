#!/usr/bin/env ruby

require "fileutils"
require "pathname-glob"

class MakeFileNamesMatchMetadata
  def data_root
    @data_root ||= Pathname(__dir__) + "../data"
  end

  def deck_files
    data_root.glob("*/*/*.txt")
  end

  def call
    deck_files.each do |path|
      title = nil
      path.readlines.each do |line|
        if line =~ %r[\A//[ \t]*NAME: (.*)]
          warn "#{path}: Multiple titles in file" if title
          title = $1
        end
      end

      unless title
        raise "#{path}: no deck name, add a `// NAME: ...` line"
      end

      # The only difference is that we use "- " to represent ": "
      # to avoid the illegal Windows character that would otherwise appear in a lot of deck names
      file_name = title.gsub(/(?<! ): /, '- ').tr("/", "-")
      target_path = path.dirname + "#{file_name}.txt"

      if path != target_path
        # Silliness to deal with case insensitive filesystems
        # and FileUtils having no idea how to deal with that
        FileUtils.mv path, "tmp"
        FileUtils.mv "tmp", target_path
      end
    end
  end
end

MakeFileNamesMatchMetadata.new.call
